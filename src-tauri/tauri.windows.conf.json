{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loadout",
        "width": 1088,
        "height": 680,
        "minWidth": 960,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
