{
  "name": "agent-loadout",
  "version": "0.7.0",
  "description": "Loadout desktop app frontend (never published to npm)",
  "license": "MIT",
  "repository": "https://github.com/DailenG/agent-loadout",
  "homepage": "https://daileng.github.io/agent-loadout/",
  "bugs": "https://github.com/DailenG/agent-loadout/issues",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml -- --ignored --exact tests::write_bindings",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tanstack/react-query": "^5.108.2",
    "@tauri-apps/api": "^2.12.5",
    "codemirror": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
