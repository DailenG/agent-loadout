{
  "manifest_version": "0.2",
  "name": "files",
  "display_name": "Files",
  "version": "1.0.0",
  "description": "Reads a folder",
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.js", "${user_config.folder}"],
      "env": { "FILES_TOKEN": "${user_config.token}" }
    }
  },
  "user_config": {
    "folder": { "type": "directory", "title": "Folder", "default": "${HOME}/Documents" },
    "token": { "type": "string", "title": "Token", "sensitive": true, "required": true }
  }
}
