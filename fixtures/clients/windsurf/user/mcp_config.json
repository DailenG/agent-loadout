{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PAT}" }
    },
    "tracker": {
      "serverUrl": "https://tracker.example.com/mcp",
      "headers": { "Authorization": "Bearer ${env:TRACKER_TOKEN}" }
    },
    "events": {
      "type": "sse",
      "url": "https://events.example.com/sse",
      "disabled": true
    },
    "notes": {
      "command": "notes-mcp",
      "disabledTools": ["delete_note"]
    }
  }
}
