{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "example-literal-token"
      }
    },
    "tracker": {
      "serverUrl": "https://tracker.example.com/mcp",
      "headers": {
        "X-Client": "example-fixture"
      },
      "timeoutSeconds": 45
    },
    "paused": {
      "command": "example-paused-mcp",
      "disabled": true,
      "disabledTools": ["delete"]
    },
    "plain-url": {
      "url": "https://plain.example.com/mcp"
    }
  }
}
