---
source: crates/agent-loadout-core/tests/adapters_tier_b.rs
expression: "golden(CURSOR, Os::Windows, &github)"
---
{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PAT}"
      },
      "envFile": "${userHome}/.example.env"
    }
  }
}

# read back
transport = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[env]
GITHUB_PERSONAL_ACCESS_TOKEN = "${env:GITHUB_PAT}"
# passthrough envFile: String("${userHome}/.example.env")
