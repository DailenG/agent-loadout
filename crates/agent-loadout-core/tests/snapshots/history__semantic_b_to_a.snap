---
source: crates/agent-loadout-core/tests/history.rs
expression: "render(&store.semantic_diff(Some(&b), &a).unwrap())"
---
secrets: changed (secrets.toml)
  secrets.GITHUB_PAT.ref: "keyring://loadout/GITHUB_PAT" -> "op://Example Vault/Fake PAT/credential"
server/github: changed (servers/github.toml)
  args: ["-y", "@modelcontextprotocol/server-github@2"] -> ["-y", "@modelcontextprotocol/server-github"]
  env.GITHUB_TOOLSETS: "repos,issues" -> "repos"
  - tags = ["dev"]
server/linear: removed (servers/linear.toml)
  - headers.Authorization = "Bearer ${secret:LINEAR_TOKEN}"
  - id = "linear"
  - schema = 1
  - transport = "http"
  - url = "https://mcp.example.test/mcp"
server/old: added (servers/old.toml)
  + command = "old-mcp"
  + id = "old"
  + schema = 1
  + transport = "stdio"
skill/review: changed (skills/review/SKILL.md)
  --- a/skills/review/SKILL.md
  +++ b/skills/review/SKILL.md
  @@ -1,3 +1,3 @@
   # Review
   
