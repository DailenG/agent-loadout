===== grok: ~/.grok/config.toml
[mcp_servers.github]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]
env = { GITHUB_TOOLSETS = "repos,issues" }

[mcp_servers.tracker]
url = "https://tracker.example.test/mcp"
headers = { X-Client = "example" }

===== grok: <P>/.grok/config.toml
[mcp_servers.repo-docs]
url = "https://docs.example.test/mcp"

[mcp_servers.repo-tools]
command = "node"
args = ["tools/mcp.js"]
