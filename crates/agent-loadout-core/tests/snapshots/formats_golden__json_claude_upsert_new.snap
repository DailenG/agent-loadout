---
source: crates/agent-loadout-core/tests/formats_golden.rs
expression: "edit(Format::Json, &lf, |doc|\n{\n    let value =\n    json(r#\"{\"type\": \"stdio\", \"command\": \"new-mcp\", \"args\": [\"--port\", \"0\"], \"env\": {\"LEVEL\": \"debug\"}}\"#);\n    assert!(doc.upsert(&[\"mcpServers\"], \"new-server\", &value).unwrap());\n})"
---
{
  "numStartups": 12,
  "theme": "dark",
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\work"],
      "env": {}
    },
    "remote-docs": {
      "type": "http",
      "url": "https://docs.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${DOCS_TOKEN}"
      }
    },
    "new-server": {
      "type": "stdio",
      "command": "new-mcp",
      "args": ["--port", "0"],
      "env": {
        "LEVEL": "debug"
      }
    }
  },
  "projects": {
    "C:/work/sample-app": {
      "allowedTools": [],
      "mcpServers": {},
      "disabledMcpServers": ["remote-docs"],
      "hasTrustDialogAccepted": true
    },
    "C:/work/other-app": {
      "allowedTools": ["Bash(npm test)"],
      "mcpServers": {
        "local-db": {
          "type": "stdio",
          "command": "uvx",
          "args": ["db-mcp", "--readonly"]
        }
      }
    }
  },
  "tipsDisabled": false
}
