---
source: crates/agent-loadout-core/tests/adapters_tier_b.rs
expression: "read_all(LEGACY, &doc)"
---
## github
transport = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[env]
GITHUB_PERSONAL_ACCESS_TOKEN = "${env:GITHUB_PAT}"
## tracker
transport = "http"
url = "https://tracker.example.com/mcp"

[headers]
Authorization = "Bearer ${input:tracker-token}"
## editor-only
transport = "stdio"
command = "example-editor-mcp"
