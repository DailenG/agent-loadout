## codex
[mcp_servers.docs]
enabled = false

## omp
{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "docs": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "example-docs-mcp"],
      "env": {
        "DOCS_ROOT": "/srv/example/docs"
      },
      "enabled": false
    }
  }
}

