## github
transport = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[env]
GITHUB_PERSONAL_ACCESS_TOKEN = "example-token"
# unmapped timeout: Integer(120)
## tracker
transport = "http"
url = "https://tracker.example.com/mcp"

[headers]
Authorization = "Bearer example-token"
## events
transport = "sse"
url = "https://events.example.com/sse"
