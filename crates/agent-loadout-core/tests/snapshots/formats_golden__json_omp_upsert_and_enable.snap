expression: "edit(Format::Json, &lf, |doc|\n{\n    let value =\n    json(r#\"{\"type\": \"stdio\", \"command\": \"notes-mcp\", \"args\": [], \"timeout\": 5000}\"#);\n    assert!(doc.upsert(&[\"mcpServers\"], \"notes\", &value).unwrap());\n    assert!(doc.set_list_member(&[\"disabledServers\"], \"notes\",\n    true).unwrap());\n    assert!(doc.set_list_member(&[\"disabledServers\"], \"issues\",\n    false).unwrap());\n})"
---
