---
source: crates/agent-loadout-core/tests/adapters_tier_c.rs
expression: "read_and_rewrite(spec, relative)"
---
## github
transport = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[env]
GITHUB_PERSONAL_ACCESS_TOKEN = "${GITHUB_PAT}"
# passthrough startup_timeout_sec: Integer(20)
## tracker
transport = "http"
url = "https://tracker.example.com/mcp"

[headers]
Authorization = "Bearer ${TRACKER_TOKEN:-anonymous}"
# passthrough tool_timeout_sec: Float(2.5)
## events
transport = "sse"
url = "https://events.example.com/sse"
## scoped
transport = "stdio"
command = "example-scoped-mcp"
# unmapped cwd: String("/srv/example")
