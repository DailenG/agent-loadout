  env.GITHUB_TOOLSETS: "repos" -> "repos,issues"
  + tags = ["dev"]
server/linear: added (servers/linear.toml)
  + headers.Authorization = "Bearer ${secret:LINEAR_TOKEN}"
  + id = "linear"
  + schema = 1
  + transport = "http"
  + url = "https://mcp.example.test/mcp"
