## claude-code (linux)
{
  "mcpServers": {
    "github": {
      "type": "stdio",
      "command": "/opt/loadout/bin/loadout",
      "args": ["exec", "--ref", "GITHUB_PERSONAL_ACCESS_TOKEN=op://Example Vault/Fake PAT/credential", "--", "npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOOLSETS": "repos,issues"
      }
    },
    "envtoken": {
      "type": "stdio",
      "command": "/opt/loadout/bin/loadout",
      "args": ["exec", "--ref", "PAT=op://Example Vault/Fake PAT/credential", "--op-env", "fakeenvironment0001", "--map", "MCP_TOKEN=MCP_TOKEN", "--", "example-mcp"]
    },
    "hass": {
      "type": "stdio",
      "command": "hass-mcp",
      "args": [],
      "env": {
        "HASS_TOKEN": "${HASS_TOKEN}"
      }
    },
    "renamed": {
      "type": "stdio",
      "command": "hass-mcp",
      "args": [],
      "env": {
        "API_KEY": "${HASS_TOKEN}"
      }
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.example.test/mcp",
      "headers": {
        "X-Team": "fake-team"
      },
      "headersHelper": "'/opt/loadout/bin/loadout' secret-header --ref 'LINEAR_TOKEN=keyring://loadout/LINEAR_TOKEN' 'Authorization=Bearer {secret:LINEAR_TOKEN}'"
    },
    "stored": {
      "type": "stdio",
      "command": "stored-mcp",
      "args": [],
      "env": {
        "STORED_TOKEN": "fake-linear-token-0001"
      }
    }
  }
}

