## codex (linux)
[mcp_servers.github]
command = "/opt/loadout/bin/loadout"
args = ["exec", "--ref", "GITHUB_PERSONAL_ACCESS_TOKEN=op://Example Vault/Fake PAT/credential", "--", "npx", "-y", "@modelcontextprotocol/server-github"]
env = { GITHUB_TOOLSETS = "repos,issues" }

[mcp_servers.envtoken]
command = "/opt/loadout/bin/loadout"
args = ["exec", "--ref", "PAT=op://Example Vault/Fake PAT/credential", "--op-env", "fakeenvironment0001", "--map", "MCP_TOKEN=MCP_TOKEN", "--", "example-mcp"]

[mcp_servers.hass]
command = "hass-mcp"
args = []
env_vars = ["HASS_TOKEN"]

[mcp_servers.renamed]
command = "/opt/loadout/bin/loadout"
args = ["exec", "--ref", "API_KEY=env:HASS_TOKEN", "--", "hass-mcp"]

[mcp_servers.linear]
url = "https://mcp.example.test/mcp"
bearer_token_env_var = "LINEAR_TOKEN"
http_headers = { X-Team = "fake-team" }

[mcp_servers.stored]
command = "stored-mcp"
args = []
env = { STORED_TOKEN = "fake-linear-token-0001" }

[mcp_servers.envheader]
url = "https://env.example.test/mcp"
bearer_token_env_var = "MCP_TOKEN"

