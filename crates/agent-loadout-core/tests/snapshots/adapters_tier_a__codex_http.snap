---
source: crates/agent-loadout-core/tests/adapters_tier_a.rs
expression: "golden(CODEX, Os::Linux, &tracker)"
---
[mcp_servers.tracker]
url = "https://tracker.example.com/mcp"
bearer_token_env_var = "TRACKER_TOKEN"
http_headers = { X-Client = "example" }
env_http_headers = { X-Workspace = "TRACKER_WORKSPACE" }
enabled = false
enabled_tools = ["search", "read"]

# read back
transport = "http"
url = "https://tracker.example.com/mcp"

[headers]
Authorization = "Bearer ${env:TRACKER_TOKEN}"
X-Client = "example"
X-Workspace = "${env:TRACKER_WORKSPACE}"
# disabled
# tools.allow: ["search", "read"]
