== servers/context7.toml ==
schema = 1
id = "context7"
description = "Library documentation lookup"
transport = "stdio"
command = "npx"
args = ["-y", "@upstash/context7-mcp"]

[tools]
deny = ["get-library-docs"]

[meta]
homepage = "https://example.invalid/context7"
origin = "migrated:skilldock"

[enable]
clients = ["claude-code", "codex"]
== servers/fetch.toml ==
schema = 1
id = "fetch"
transport = "stdio"
command = "uvx"
args = ["mcp-server-fetch"]

[meta]
origin = "migrated:skilldock"

[enable]
clients = ["claude-code"]
== servers/notes.toml ==
schema = 1
id = "notes"
transport = "stdio"
command = "/opt/example/bin/notes-mcp"
args = ["--token", "${secret:NOTES_TOKEN}", "--verbose"]

[env]
LOG_LEVEL = "info"
NOTES_API_KEY = "${secret:NOTES_NOTES_API_KEY}"

[meta]
origin = "migrated:skilldock"

[enable]
clients = ["claude-code", "codex", "legacy-ide"]
== servers/remote-docs.toml ==
schema = 1
id = "remote-docs"
display_name = "Remote Docs"
transport = "http"
url = "https://docs.example.invalid/mcp"

[headers]
Authorization = "Bearer ${secret:REMOTE_DOCS_AUTHORIZATION}"

[tools]
deny = ["admin_reset"]

[client.cursor]
native_name = "Remote-Docs"

[client.windsurf]
native_name = "Remote-Docs"

[meta]
origin = "migrated:skilldock"

[enable]
clients = ["cursor", "windsurf"]
== servers/time.toml ==
schema = 1
id = "time"
transport = "stdio"
command = "uvx"
args = ["mcp-server-time"]

[meta]
origin = "migrated:skilldock"

[enable]
clients = ["codex"]
== settings.toml ==
schema = 1
theme = "dark"
new_server_enable = "all-detected"
new_skill_enable = "none"
agents_cli_compat = true
== skill-meta/repo-notes.toml ==
schema = 1
id = "repo-notes"
